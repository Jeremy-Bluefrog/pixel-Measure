        <!-- Ruler Graduation Ticks (White crisp ticks along tape) -->
        <path
            android:pathData="M 36,60 L 42,66 M 43,53 L 47,57 M 50,46 L 56,52 M 57,39 L 61,43 M 64,32 L 70,38"
            android:strokeWidth="3"
            android:strokeColor="#FFFFFF"
