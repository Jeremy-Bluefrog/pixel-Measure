                    android:startY="26"
                    android:endX="82"
                    android:endY="82"
                    android:type="linear">
                    <item android:color="#FF38BDF8" android:offset="0.0" />
                    <item android:color="#FFA855F7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- AR Reticle Laser Points (Floating Cyan/Purple Accent Orbs) -->
        <path
            android:pathData="M 54,20 L 54,15 M 54,93 L 54,88 M 20,54 L 15,54 M 93,54 L 88,54"
            android:strokeWidth="3.5"
            android:strokeColor="#FF0284C7"
            android:strokeLineCap="round" />

        <path
            android:pathData="M 54,54 A 5,5 0 1,1 44,54 A 5,5 0 1,1 54,54 Z"
            android:fillColor="#FFFFFF" />
