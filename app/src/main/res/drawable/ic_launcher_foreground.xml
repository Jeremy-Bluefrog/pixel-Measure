                    android:endY="24"
                    android:type="linear">
                    <item android:color="#FF1D4ED8" android:offset="0.0" />
                    <item android:color="#FF06B6D4" android:offset="0.5" />
                    <item android:color="#FF8B5CF6" android:offset="1.0" />
                </gradient>
            </aapt:attr>
